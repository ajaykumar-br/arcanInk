# Copy to .env and fill in. .env is git-ignored and excluded from Docker images;
# never commit it. docker compose refuses to start while a required value is empty.

# --- required secrets (no defaults) -----------------------------------------
POSTGRES_USER=arcanink
# Generate with:  openssl rand -hex 24   (hex keeps the DATABASE_URL free of characters needing escaping)
POSTGRES_PASSWORD=
# Shared by http-backend and ws-backend. Generate with:  openssl rand -hex 32
JWT_SECRET=

# --- non-secret config (defaults are fine) ------------------------------------
POSTGRES_DB=arcanink

# Where the *browser* reaches the backends (public, baked into the web image at build time).
NEXT_PUBLIC_HTTP_BACKEND_URL=http://localhost:3001
NEXT_PUBLIC_WS_URL=ws://localhost:8080
