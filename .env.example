# Copy to .env to override the docker-compose defaults.
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=arcanink

# Shared by http-backend and ws-backend; set a long random value outside local use.
JWT_SECRET=change-me-in-production

# Where the *browser* reaches the backends (baked into the web image at build time).
NEXT_PUBLIC_HTTP_BACKEND_URL=http://localhost:3001
NEXT_PUBLIC_WS_URL=ws://localhost:8080
