FROM node:20-alpine AS build
RUN corepack enable && corepack prepare pnpm@9.0.0 --activate
WORKDIR /usr/src/app

COPY ./pnpm-lock.yaml ./pnpm-workspace.yaml ./turbo.json ./package.json ./
COPY ./packages ./packages
COPY ./apps/web ./apps/web

RUN pnpm install --frozen-lockfile --filter web...

# NEXT_PUBLIC_* values are inlined into the browser bundle at build time, so they must be
# the addresses a *browser* uses to reach the backends, not Docker-internal hostnames.
ARG NEXT_PUBLIC_HTTP_BACKEND_URL=http://localhost:3001
ARG NEXT_PUBLIC_WS_URL=ws://localhost:8080
ENV NEXT_PUBLIC_HTTP_BACKEND_URL=$NEXT_PUBLIC_HTTP_BACKEND_URL \
    NEXT_PUBLIC_WS_URL=$NEXT_PUBLIC_WS_URL \
    NEXT_TELEMETRY_DISABLED=1
RUN cd apps/web && pnpm build

FROM node:20-alpine AS runner
WORKDIR /usr/src/app
ENV NODE_ENV=production \
    NEXT_TELEMETRY_DISABLED=1 \
    PORT=3000 \
    HOSTNAME=0.0.0.0

COPY --from=build /usr/src/app/apps/web/.next/standalone ./
COPY --from=build /usr/src/app/apps/web/.next/static ./apps/web/.next/static
COPY --from=build /usr/src/app/apps/web/public ./apps/web/public

USER node
EXPOSE 3000
CMD ["node", "apps/web/server.js"]
